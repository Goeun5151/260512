# Copy this file to local.properties and fill in your values.
# local.properties is git-ignored and must NOT be committed.

# Android SDK location (Android Studio fills this in automatically)
# sdk.dir=/path/to/Android/Sdk

# Naver Book Search API (https://developers.naver.com/apps)
# Without these keys the app still works fully — book search just falls
# back to manual entry of title / author.
naver.clientId=
naver.clientSecret=
